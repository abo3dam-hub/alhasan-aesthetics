  "testimonials": {
    "badge": "\u062a\u062c\u0627\u0631\u0628 \u0627\u0644\u0645\u0631\u0636\u0649",
    "title": "\u0645\u0627 \u064a\u0642\u0648\u0644",
    "titleHighlight": "\u0645\u0631\u0636\u0627\u0646\u0627",
    "subtitle": "\u0642\u0635\u0635 \u062d\u0642\u064a\u0642\u064a\u0629 \u0645\u0646 \u0645\u0631\u0636\u0649 \u0639\u0627\u0634\u0648\u0627 \u062a\u062c\u0631\u0628\u0629 \u0645\u0645\u064a\u0632\u0629 \u0645\u0639\u0646\u0627.",
    "t1Name": "\u0633\u0627\u0631\u0629 \u0623.",
    "t1Text": "\u062a\u062c\u0631\u0628\u062a\u064a \u0645\u0639 \u062f. \u0627\u0644\u062d\u0633\u0646 \u0643\u0627\u0646\u062a \u0627\u0633\u062a\u062b\u0646\u0627\u0626\u064a\u0629. \u0627\u0644\u0646\u062a\u0627\u0626\u062c \u0641\u0627\u0642\u062a \u062a\u0648\u0642\u0639\u0627\u062a\u064a \u0628\u0643\u062b\u064a\u0631 \u0648\u0627\u0644\u0639\u0646\u0627\u064a\u0629 \u0645\u0646 \u0627\u0644\u0641\u0631\u064a\u0642 \u0643\u0627\u0646\u062a \u0631\u0627\u0626\u0639\u0629. \u0623\u0646\u0635\u062d \u0628\u0647 \u0628\u0634\u062f\u0629 \u0644\u0644\u0623\u064a \u064a\u0641\u062a\u0643\u0631 \u0641\u064a \u0625\u062c\u0631\u0627\u0621 \u062a\u062c\u0645\u064a\u0644\u064a.",
    "t2Name": "\u0645\u062d\u0645\u062f \u0631.",
    "t2Text": "\u0628\u0639\u062f \u0633\u0646\u0648\u0627\u062a \u0645\u0646 \u0627\u0644\u062a\u0641\u0643\u064a\u0631\u060c \u0642\u0631\u0631\u062a \u0623\u062e\u064a\u0631\u0627\u064b \u0623\u062c\u0631\u0627\u0621 \u062a\u062c\u0645\u064a\u0644 \u0627\u0644\u0623\u0646\u0641. \u062f. \u0627\u0644\u062d\u0633\u0646 \u062c\u0639\u0644 \u0627\u0644\u062a\u062c\u0631\u0628\u0629 \u0633\u0647\u0644\u0629 \u0648\u0645\u0631\u064a\u062d\u0629 \u0648\u0627\u0644\u0646\u062a\u0627\u0626\u062c \u0637\u0628\u064a\u0639\u064a\u0629 \u062a\u0645\u0627\u0645\u0627\u064b. \u0644\u0645 \u064a\u062a\u0639\u0631\u0641\u0646\u064a \u0623\u062d\u062f!",
    "t3Name": "\u0644\u064a\u0644\u0649 \u0643.",
    "t3Text": "\u0627\u0644\u0627\u062d\u062a\u0631\u0627\u0641\u064a\u0629 \u0648\u0627\u0644\u0639\u0646\u0627\u064a\u0629 \u0628\u0627\u0644\u062a\u0641\u0635\u064a\u0644 \u0645\u0644\u0627 \u0645\u062b\u064a\u0644 \u0644\u0627. \u0623\u0634\u0639\u0631 \u0628\u0627\u0644\u0634\u0628\u0627\u0628 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649 \u0648\u0627\u0644\u062b\u0642\u0629 \u0628\u0645\u0644\u0627\u0645\u062d\u064a \u0639\u0627\u062f\u062a \u0628\u0627\u0644\u0643\u0627\u0645\u0644."
  },
  "faq": {
    "badge": "\u0627\u0644\u0623\u0633\u0626\u0644\u0629 \u0627\u0644\u0634\u0627\u0626\u0639\u0629",
    "title": "\u0627\u0644\u0623\u0633\u0626\u0644\u0629",
    "titleHighlight": "\u0627\u0644\u0623\u0643\u062b\u0631 \u0634\u064a\u0648\u0639\u0627\u064b",
    "subtitle": "\u0625\u062c\u0627\u0628\u0627\u062a \u0639\u0644\u0649 \u0627\u0644\u0623\u0633\u0626\u0644\u0629 \u0627\u0644\u0623\u0643\u062b\u0631 \u062a\u0643\u0631\u0627\u0631\u0627\u064b \u062d\u0648\u0644 \u0625\u062c\u0631\u0627\u0621\u0627\u062a\u0646\u0627 \u0648\u062e\u062f\u0645\u0627\u062a\u0646\u0627.",
    "q1": "\u0643\u064a\u0641 \u0623\u0639\u0631\u0641 \u0627\u0644\u0625\u062c\u0631\u0627\u0621 \u0627\u0644\u0645\u0646\u0627\u0633\u0628 \u0644\u064a؟",
    "a1": "\u0646\u0642\u062f\u0645 \u0627\u0633\u062a\u0634\u0627\u0631\u0629 \u0645\u062c\u0627\u0646\u064a\u0629 \u0634\u0627\u0645\u0644\u0629 \u062d\u064a\u062b\u0648\u062b \u062f. \u0627\u0644\u062d\u0633\u0646 \u064a\u0642\u064a\u0645 \u0628\u062a\u0642\u064a\u064a\u0645 \u0627\u0644\u0627\u062d\u062a\u064a\u0627\u062c\u0627\u062a \u0648u064a\u0634\u0631\u062d \u062c\u0645\u064a\u0639 \u0627\u0644\u062e\u064a\u0627\u0631\u0627\u062a \u0627\u0644\u0645\u062a\u0627\u062d\u0629. \u0643\u0644 \u062e\u0637\u0629 \u0639\u0644\u0627\u062c\u062c\u064a\u0629 \u0645\u062e\u0635\u0635\u0629 \u0644u0643\u0644 \u0645\u0631\u064a\u0636.",
    "q2": "\u0643\u0645 \u062a\u0633\u062a\u0645\u0631 \u0641\u062a\u0631\u0629 \u0627\u0644\u062a\u0639\u0627\u0641\u064a\u061f",
    "a2": "\u062a\u062e\u062a\u0644\u0641 \u0645\u062f\u0629 \u0627\u0644\u062a\u0639\u0627\u0641\u064a \u062d\u0633\u0628 \u0627\u0644\u0625\u062c\u0631\u0627\u0621. \u0628\u0634\u0643\u0644 \u0639\u0627\u0645\u060c \u064a\u0639\u0648\u062f \u0645\u0639\u0638\u0645 \u0627\u0644\u0645\u0631\u0636\u0649 \u0644\u0646\u0634\u0627\u0637\u0647\u0645 \u0627\u0644\u0637\u0628\u064a\u0639\u064a\u0629 \u062e\u0644\u0627\u0644 1-2 \u0623\u0633\u0628\u0648\u0639. \u0646\u0642\u062f\u0645 \u062a\u0639\u0644\u064a\u0645\u0627\u062a \u0631\u0639\u0627\u064a\u0629 \u0645\u0641\u0635\u0644\u0629 \u0628\u0639\u062f \u0643\u0644 \u0625\u062c\u0631\u0627\u0621.",
    "q3": "\u0647\u0644 \u0627\u0644\u0646\u062a\u0627\u0626\u062c \u0637\u0628\u064a\u0639\u064a\u0629\u061f",
    "a3": "\u0628\u0627\u0644\u0637\u0628\u064a\u0639. \u0646\u062d\u0646 \u0645\u062a\u062e\u0635\u0635\u0648\u0646 \u0641\u064a \u062a\u062d\u0642\u064a\u0642 \u0646\u062a\u0627\u0626\u062c \u0637\u0628\u064a\u0639\u064a\u0629 \u062a\u0639\u0632\u0632 \u0645\u0644\u0627\u0645\u062d\u0643 \u0628\u062f\u0648\u0646 \u062a\u063a\u064a\u064a\u0631 \u0645\u0638\u0647\u0631\u0643. \u0647\u062f\u0641\u0646\u0627 \u0623\u0646 \u0646\u0628\u0631\u0632 \u0623\u0641\u0636\u0644 \u0646\u0633\u062e\u0629 \u0645\u0646\u0643.",
    "q4": "\u0647\u0644 \u0627\u0644\u062c\u0631\u0627\u062d\u0629 \u0622\u0645\u0646\u0629\u061f",
    "a4": "\u0627\u0644\u0633\u0644\u0627\u0645\u0629 \u0623\u0648\u0644\u0648\u064a\u062a\u0646\u0627 \u0627\u0644\u0642\u0635\u0648\u0649. \u0646\u0633\u062a\u062e\u062f\u0645 \u0623\u062d\u062f\u062b \u0627\u0644\u0645\u0639\u062f\u0627\u062a \u0648\u0627\u0644\u062a\u0642\u0646\u064a\u0627\u062a \u0627\u0644\u0645\u0639\u062a\u0645\u062f\u0629 \u062f\u0648\u0644\u064a\u0627\u064b. \u062f. \u0627\u0644\u062d\u0633\u0646 \u062d\u0627\u0635\u0644 \u0639\u0644\u0649 \u0634\u0647\u0627\u062f\u0627\u062a \u0645\u0646 \u0623\u0639\u0631\u0642 \u0627\u0644\u062c\u0645\u0648\u0639\u0627\u062a \u0627\u0644\u0637\u0628\u064a\u0639\u064a\u0629 \u0627\u0644\u0639\u0627\u0644\u064a\u0629.",
    "q5": "\u0645\u0627 \u0647\u064a \u0637\u0631\u0642 \u0627\u0644\u062f\u0641\u0639 \u0627\u0644\u0645\u062a\u0627\u062d\u0629\u061f",
    "a5": "\u0646\u0642\u0628\u0644 \u0645\u062e\u062a\u0644\u0641 \u0645\u0646 \u0648\u0633\u0627\u0626\u0644 \u0627\u0644\u062f\u0641\u0639 \u0648\u0646\u0642\u062f\u0645 \u062e\u0637\u0637 \u062f\u0641\u0639 \u0645\u0631\u0646\u0637\u0642. \u064a\u0645\u0643\u0646 \u0645\u0646\u0627\u0642\u0634\u0629 \u062c\u0645\u064a\u0639 \u0627\u0644\u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u0645\u0627\u0644\u064a\u0629 \u062e\u0644\u0627\u0644 \u0627\u0644\u0627\u0633\u062a\u0634\u0627\u0631\u0629 \u0627\u0644\u0623\u0648\u0644\u0649.",
    "q6": "\u0647\u0644 \u064a\u0645\u0643\u0646\u0646\u064a \u0631\u0624\u064a\u0629 \u0646\u062a\u0627\u0626\u062c \u0645\u0634\u0627\u0628\u0647\u0629 \u0644\u062d\u0627\u0644\u062a\u064a\u061f",
    "a6": "\u0628\u0627\u0644\u0637\u0628\u064a\u0639! \u0644\u062f\u064a\u0646\u0627 \u0645\u0639\u0631\u0636 \u0634\u0627\u0645\u0644 \u0645\u0646 \u0635\u0648\u0631 \u0642\u0628\u0644 \u0648\u0628\u0639\u062f \u0644\u0645\u062c\u0645\u0648\u0639\u0629 \u0645\u062a\u0646\u0648\u0639\u0629 \u0645\u0646 \u0627\u0644\u0625\u062c\u0631\u0627\u0621\u0627\u062a. \u064a\u0645\u0643\u0646 \u0644\u062f. \u0627\u0644\u062d\u0633\u0646 \u0623\u064a\u0636\u0627\u064b \u0646\u062a\u0627\u0626\u062c \u0645\u0634\u0627\u0628\u0647\u0629 \u0644\u062d\u0627\u0644\u062a\u0643 \u0627\u0644\u062e\u0627\u0635\u0629 \u062e\u0644\u0627\u0644 \u0627\u0644\u0627\u0633\u062a\u0634\u0627\u0631\u0629."
  },
